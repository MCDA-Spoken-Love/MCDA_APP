{
  "expo": {
    "name": "MCDA",
    "slug": "MCDA",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mcdaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "bundleIdentifier": "com.mcda.MCDA-APP"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6D9A2",
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/adaptive-icon.png"
      },
      "package": "com.mcda.MCDA_APP"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#624E88",
          "image": "./assets/icons/splash-icon-dark.png",
          "imageWidth": 200
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0514377e-388c-43b0-aaa3-cbcf36394b47"
      }
    }
  }
}
